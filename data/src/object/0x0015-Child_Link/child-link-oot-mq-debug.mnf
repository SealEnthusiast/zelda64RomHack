        patch.write32("gPlayAsLUT_Child_BowFistR")

//D_80125E78
        patch.write32("gPlayAsLUT_Child_SheathedSword")         // gLinkChildSwordAndSheathNearDL
        patch.write32("gPlayAsLUT_Child_SheathedSword")

//D_80125E88
